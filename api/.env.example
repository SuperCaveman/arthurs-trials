# Development-only Session API configuration. Do not commit api/.env.
SESSION_API_PORT=8080
GAME_LIFT_ADAPTER=fake

# Required only when GAME_LIFT_ADAPTER=anywhere.
AWS_REGION=us-east-1
GAME_LIFT_FLEET_ID=fleet-REPLACE_ME
GAME_LIFT_LOCATION=custom-arthurs-trials-local

# Required only when GAME_LIFT_ADAPTER=managed-fleet. This is a short-lived
# direct-fleet proof mode; use the queue adapter for the scalable design.
GAME_LIFT_MANAGED_FLEET_ID=containerfleet-REPLACE_ME
